{
  "name": "wide-example-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --test *.test.js",
    "flights": "node flights.js",
    "test:flights": "node --test flights.test.js",
    "gateway": "node --require ./tracing.js gateway.js",
    "articles": "node --require ./tracing.js articles.js",
    "notifications": "node --require ./tracing.js notifications.js",
    "users": "node --require ./tracing.js users.js",
    "payments": "node --require ./tracing.js payments.js",
    "media": "node --require ./tracing.js media.js",
    "all": "concurrently \"npm run gateway\" \"npm run articles\" \"npm run notifications\" \"npm run users\" \"npm run payments\" \"npm run media\""
  },
  "dependencies": {
    "protobufjs": "7.6.6",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.55.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.55.0",
    "@opentelemetry/sdk-metrics": "^1.28.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/sdk-trace-base": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "express": "^4.21.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
